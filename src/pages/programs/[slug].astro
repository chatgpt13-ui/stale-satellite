---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

export const getStaticPaths = async () =>
  (await getCollection('program')).map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));

const { item } = Astro.props;
const metadata = {
  title: item.data.title,
  description: item.data.summary,
};
---

<Layout metadata={metadata}>
  <section class="border-b border-stone-200 bg-white">
    <div class="mx-auto max-w-5xl px-4 py-16 md:px-6 md:py-20">
      <div class="flex flex-wrap items-center gap-3">
        <span class="rounded-full bg-red-700 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-white">
          {item.data.badge}
        </span>
        <span class="text-sm text-stone-500">{item.data.category}</span>
        <span class="text-sm text-stone-500">{item.data.date}</span>
      </div>
      <h1 class="mt-5 text-4xl font-semibold text-stone-900 md:text-5xl">{item.data.title}</h1>
      <p class="mt-6 text-lg leading-8 text-stone-700">{item.data.summary}</p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16 md:px-6">
    <div class="grid gap-6 md:grid-cols-2">
      <article class="rounded-[1.75rem] border border-stone-200 bg-white p-7">
        <h2 class="text-2xl font-semibold text-stone-900">Program Overview</h2>
        <dl class="mt-6 space-y-4 text-sm text-stone-700">
          <div>
            <dt class="text-stone-500">Format</dt>
            <dd class="mt-1">{item.data.format}</dd>
          </div>
          <div>
            <dt class="text-stone-500">Audience</dt>
            <dd class="mt-1">{item.data.audience}</dd>
          </div>
          <div>
            <dt class="text-stone-500">Date</dt>
            <dd class="mt-1">{item.data.date}</dd>
          </div>
        </dl>
      </article>
      <article class="rounded-[1.75rem] border border-stone-200 bg-white p-7">
        <h2 class="text-2xl font-semibold text-stone-900">Learning Outcomes</h2>
        <ul class="mt-6 space-y-3 text-sm text-stone-700">
          {item.data.outcomes.map((outcome) => <li class="rounded-xl bg-neutral-100 px-4 py-3">{outcome}</li>)}
        </ul>
      </article>
    </div>
  </section>
</Layout>
