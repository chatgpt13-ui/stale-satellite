---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

export const getStaticPaths = async () =>
  (await getCollection('update')).map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));

const { item } = Astro.props;
const metadata = {
  title: item.data.title,
  description: item.data.summary,
};
---

<Layout metadata={metadata}>
  <section class="border-b border-stone-200 bg-white">
    <div class="mx-auto max-w-5xl px-4 py-16 md:px-6 md:py-20">
      <span
        class="rounded-full border border-red-700 bg-white px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-red-700"
      >
        {item.data.type}
      </span>
      <p class="mt-5 text-sm text-stone-500">{item.data.date}</p>
      <h1 class="mt-3 text-4xl font-semibold text-stone-900 md:text-5xl">{item.data.title}</h1>
      <p class="mt-6 text-lg leading-8 text-stone-700">{item.data.summary}</p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16 md:px-6">
    <article class="rounded-[2rem] border border-stone-200 bg-white p-8">
      <div class="space-y-6 text-base leading-8 text-stone-600">
        {item.data.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </article>
  </section>
</Layout>
