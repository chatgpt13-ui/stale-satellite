---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'CONC Thammasat',
  ignoreTitleTemplate: true,
  description:
    'หลักสูตรฝึกอบรม สัมมนา และบริการให้คำปรึกษาสำหรับองค์กรและบุคคลทั่วไป โดยโครงสร้างหน้าเว็บออกแบบใหม่ในสไตล์สถาบันการศึกษาวิชาชีพ',
};

const serviceCards = [
  {
    title: 'Open Enrollment Programs',
    subtitle: 'หลักสูตรอบรมสำหรับบุคคลทั่วไป',
    description:
      'รวมหลักสูตรระยะสั้น ระยะยาว และออนไลน์ สำหรับผู้บริหาร ผู้ประกอบการ และบุคลากรที่ต้องการอัปสกิลอย่างเป็นระบบ',
    icon: 'tabler:book-2',
    href: getPermalink('/conc/training/open-enrollment'),
  },
  {
    title: 'Customized Training',
    subtitle: 'หลักสูตรอบรมเฉพาะองค์กร',
    description:
      'ออกแบบเนื้อหาให้ตรงกับบริบทธุรกิจ เป้าหมาย และระดับของผู้เรียน พร้อม workshop ที่นำไปใช้ได้จริงในองค์กร',
    icon: 'tabler:building-bank',
    href: getPermalink('/conc/training/customized-training'),
  },
  {
    title: 'Consulting Service',
    subtitle: 'ที่ปรึกษาและโครงการวิจัย',
    description:
      'สนับสนุนการวางกลยุทธ์ การพัฒนาองค์กร และการขับเคลื่อนโครงการสำคัญผ่านผู้เชี่ยวชาญจากภาควิชาการและภาคธุรกิจ',
    icon: 'tabler:briefcase-2',
    href: getPermalink('/conc/consulting/service-field'),
  },
  {
    title: 'Knowledge & Forum',
    subtitle: 'องค์ความรู้และกิจกรรมวิชาการ',
    description: 'เผยแพร่บทความ วิดีโอ และเวทีแลกเปลี่ยนความรู้ที่ช่วยต่อยอดการเรียนรู้ตลอดชีวิตสำหรับภาครัฐและเอกชน',
    icon: 'tabler:video',
    href: getPermalink('/conc/learning/knowledge-articles'),
  },
];

const categories = [
  'Finance & Accounting',
  'Management Development',
  'Strategy Development',
  'Marketing',
  'Human Resource',
  'Online Courses',
];

const featuredPrograms = [
  {
    title: 'Strategic Insights into China’s Economy and Capital Markets',
    date: '16 May 2026',
    badge: 'Update',
    href: getPermalink('/programs/strategic-insights-china-capital-markets'),
    description:
      'หลักสูตรสำหรับผู้บริหารและนักลงทุนที่ต้องการเข้าใจเศรษฐกิจจีน โครงสร้างตลาดทุน และแนวโน้มการลงทุนระหว่างประเทศ',
  },
  {
    title: 'Modern Management for Global Competency',
    date: '9 May 2026',
    badge: 'International',
    href: getPermalink('/programs/modern-management-global-competency'),
    description: 'เสริมทักษะผู้นำยุคใหม่ การตัดสินใจเชิงกลยุทธ์ และการขับเคลื่อนองค์กรในบริบทการแข่งขันระดับโลก',
  },
  {
    title: 'AI Essentials for Business',
    date: '28-29 May 2026',
    badge: 'Popular',
    href: getPermalink('/programs/ai-essentials-for-business'),
    description:
      'ปูพื้นฐาน AI เพื่อเพิ่มประสิทธิภาพการทำงาน ออกแบบ use case ในองค์กร และนำเทคโนโลยีไปใช้ได้อย่างรับผิดชอบ',
  },
  {
    title: 'Finance for Non-financial Executive',
    date: '6 Jun - 18 Jul 2026',
    badge: 'Executive',
    href: getPermalink('/programs/finance-for-non-financial-executive'),
    description:
      'ช่วยผู้บริหารที่ไม่มีพื้นฐานบัญชีและการเงินให้เข้าใจงบการเงิน ต้นทุน และการตัดสินใจทางธุรกิจอย่างมั่นใจ',
  },
];

const updates = [
  {
    type: 'Announcement',
    title: 'เปิดรับสมัครหลักสูตรสำหรับไตรมาส 3',
    href: getPermalink('/updates/q3-program-enrollment-open'),
    description: 'สื่อสารกำหนดการรุ่นใหม่ ช่องทางสมัคร และสิทธิประโยชน์สำหรับองค์กรที่ต้องการส่งทีมเข้าอบรมหลายท่าน',
  },
  {
    type: 'Event',
    title: 'CONC Forum: Future Skills for Thai Executives',
    href: getPermalink('/updates/future-skills-for-thai-executives-forum'),
    description: 'เวทีเสวนาสำหรับผู้บริหารเพื่อสำรวจทักษะที่จำเป็นต่อการแข่งขันในเศรษฐกิจดิจิทัลและยุค AI',
  },
  {
    type: 'Knowledge',
    title: 'บทความเด่นด้าน Strategy และ Leadership',
    href: getPermalink('/updates/strategy-and-leadership-knowledge-series'),
    description: 'คัดเนื้อหาเพื่อสนับสนุนการเรียนรู้ต่อเนื่องและสร้างภาพลักษณ์ศูนย์ความรู้ของสถาบันบนหน้าแรก',
  },
];
---

<Layout metadata={metadata}>
  <section class="relative overflow-hidden border-b border-stone-200 bg-white">
    <div
      class="relative mx-auto grid max-w-7xl gap-12 px-4 py-16 md:px-6 md:py-20 lg:grid-cols-[1.2fr_0.8fr] lg:items-center"
    >
      <div>
        <p
          class="mb-4 inline-flex rounded-full border border-red-700 bg-white px-4 py-1 text-sm font-semibold uppercase tracking-[0.18em] text-red-700"
        >
          Thammasat Consulting Networking and Coaching Center
        </p>
        <h1 class="max-w-4xl text-4xl font-semibold leading-tight text-stone-900 md:text-5xl lg:text-6xl">
          หลักสูตรฝึกอบรม สัมมนา และงานให้คำปรึกษา
          <span class="block text-red-700">สำหรับผู้นำ องค์กร และผู้เรียนรู้ตลอดชีวิต</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-700">
          หน้าแรกถูกปรับใหม่ให้มีลำดับข้อมูลแบบเว็บไซต์สถาบันอบรม: เริ่มจากบริการหลัก หมวดหลักสูตรเด่น ข่าวสาร
          และช่องทางติดต่อ เพื่อให้ผู้ใช้เข้าถึงเส้นทางสมัครเรียนหรือขอคำปรึกษาได้เร็วขึ้น
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a class="btn-primary !rounded-md !px-7 !py-3.5" href="#featured-programs">ดูหลักสูตรเด่น</a>
          <a class="btn-secondary !rounded-md !border-stone-300 !px-7 !py-3.5 !text-stone-800" href="#services"
            >สำรวจบริการ</a
          >
        </div>
        <dl class="mt-10 grid gap-5 text-sm text-stone-700 sm:grid-cols-3">
          <div
            class="rounded-2xl border border-white/70 bg-white/75 p-5 shadow-[0_12px_40px_-24px_rgba(41,37,36,0.45)]"
          >
            <dt class="text-stone-500">Program tracks</dt>
            <dd class="mt-2 text-3xl font-semibold text-stone-900">6</dd>
          </div>
          <div
            class="rounded-2xl border border-white/70 bg-white/75 p-5 shadow-[0_12px_40px_-24px_rgba(41,37,36,0.45)]"
          >
            <dt class="text-stone-500">Training formats</dt>
            <dd class="mt-2 text-3xl font-semibold text-stone-900">4</dd>
          </div>
          <div
            class="rounded-2xl border border-white/70 bg-white/75 p-5 shadow-[0_12px_40px_-24px_rgba(41,37,36,0.45)]"
          >
            <dt class="text-stone-500">Audience focus</dt>
            <dd class="mt-2 text-3xl font-semibold text-stone-900">Executives</dd>
          </div>
        </dl>
      </div>

      <div class="relative">
        <div class="rounded-[2rem] border border-neutral-900 bg-neutral-950 p-6 text-white">
          <div class="grid gap-4 md:grid-cols-2">
            {
              serviceCards.slice(0, 2).map((card) => (
                <article class="rounded-2xl border border-white/10 bg-white/5 p-5">
                  <Icon name={card.icon} class="h-7 w-7 text-red-600" />
                  <h2 class="mt-4 text-lg font-semibold">{card.title}</h2>
                  <p class="mt-1 text-sm font-medium text-red-600">{card.subtitle}</p>
                  <p class="mt-3 text-sm leading-6 text-white/75">{card.description}</p>
                </article>
              ))
            }
          </div>
          <div class="mt-4 rounded-2xl border border-neutral-700 bg-white p-5 text-stone-900">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-red-700">Quick access</p>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              <a
                class="rounded-xl border border-stone-300 bg-white px-4 py-3 text-sm font-medium transition hover:border-red-600 hover:text-red-700"
                href="#featured-programs"
              >
                Courses accepting applications
              </a>
              <a
                class="rounded-xl border border-stone-300 bg-white px-4 py-3 text-sm font-medium transition hover:border-red-600 hover:text-red-700"
                href="#updates"
              >
                News and event updates
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="services" class="mx-auto max-w-7xl px-4 py-16 md:px-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-red-700">Core services</p>
        <h2 class="mt-3 text-3xl font-semibold text-stone-900 md:text-4xl">
          บริการหลักสำหรับผู้เรียน องค์กร และหน่วยงานภาคี
        </h2>
      </div>
      <p class="max-w-2xl text-base leading-7 text-stone-600">
        แต่ละการ์ดทำหน้าที่เป็น entry point ให้ผู้ใช้เข้าใจประเภทบริการตั้งแต่เปิดหน้า
        และสามารถแตกไปยังหน้ารายละเอียดจริงภายหลังได้
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      {
        serviceCards.map((card) => (
          <article class="group rounded-[1.75rem] border border-stone-200 bg-white p-6 transition hover:-translate-y-1 hover:border-red-700">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-neutral-100 text-red-700">
              <Icon name={card.icon} class="h-6 w-6" />
            </div>
            <h3 class="mt-5 text-xl font-semibold text-stone-900">{card.title}</h3>
            <p class="mt-2 text-sm font-medium text-red-700">{card.subtitle}</p>
            <p class="mt-4 text-sm leading-7 text-stone-600">{card.description}</p>
            <a
              class="mt-6 inline-flex items-center text-sm font-semibold text-neutral-900"
              href={card.href}
            >
              Read more
              <Icon name="tabler:arrow-right" class="ml-2 h-4 w-4" />
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section id="featured-programs" class="border-y border-stone-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 md:px-6">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-red-700">Featured programs</p>
          <h2 class="mt-3 text-3xl font-semibold text-stone-900 md:text-4xl">Courses accepting applications</h2>
        </div>
        <p class="max-w-2xl text-base leading-7 text-stone-600">
          จัดวางหมวดหลักสูตรเด่นและรายการเปิดรับสมัครในลำดับเดียวกับเว็บไซต์อ้างอิง เพื่อดึงผู้ใช้เข้าสู่ conversion
          path ให้เร็วที่สุด
        </p>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        {
          categories.map((category) => (
            <span class="rounded-full border border-stone-300 bg-white px-4 py-2 text-sm font-medium text-stone-700">
              {category}
            </span>
          ))
        }
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {
          featuredPrograms.map((program) => (
            <article class="rounded-[1.75rem] border border-stone-200 bg-white p-7">
              <div class="flex flex-wrap items-center gap-3">
                <span class="rounded-full bg-red-700 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-white">
                  {program.badge}
                </span>
                <span class="text-sm text-stone-500">{program.date}</span>
              </div>
              <h3 class="mt-5 text-2xl font-semibold leading-snug text-stone-900">{program.title}</h3>
              <p class="mt-4 text-sm leading-7 text-stone-600">{program.description}</p>
              <a class="mt-6 inline-flex items-center text-sm font-semibold text-red-700" href={program.href}>
                Read more
                <Icon name="tabler:arrow-up-right" class="ml-2 h-4 w-4" />
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-7xl gap-10 px-4 py-16 md:px-6 lg:grid-cols-[0.9fr_1.1fr]">
    <div class="rounded-[2rem] bg-neutral-950 p-8 text-white">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-red-600">About CONC</p>
      <h2 class="mt-4 text-3xl font-semibold leading-tight">
        ศูนย์กลางข้อมูลสำหรับการเรียนรู้ การพัฒนาผู้บริหาร และงานที่ปรึกษา
      </h2>
      <p class="mt-5 text-base leading-8 text-white/75">
        หน้าใหม่เน้นสื่อสารลำดับข้อมูลแบบ institution landing page: ภาพรวมองค์กร, กลุ่มบริการหลัก, รายการหลักสูตร,
        ข่าวสาร, และข้อมูลติดต่อในหน้าเดียวกัน เพื่อลดการพึ่งพาหน้า demo ของธีมเดิม
      </p>
      <ul class="mt-8 space-y-4 text-sm text-white/80">
        <li class="flex gap-3">
          <Icon name="tabler:check" class="mt-0.5 h-5 w-5 text-red-600" />
          <span>เมนูหลักครอบคลุมหมวด About, Training, Consulting, Learning, News และ Contact</span>
        </li>
        <li class="flex gap-3">
          <Icon name="tabler:check" class="mt-0.5 h-5 w-5 text-red-600" />
          <span>หน้าแรกเน้น featured programs และ updates เพื่อพาผู้ใช้ไปยังข้อมูลที่ต้องการได้เร็ว</span>
        </li>
        <li class="flex gap-3">
          <Icon name="tabler:check" class="mt-0.5 h-5 w-5 text-red-600" />
          <span>โทนภาพรวมสื่อสารความเป็นสถาบันวิชาชีพด้วยสีแดง ดำ เทา และขาว</span>
        </li>
      </ul>
    </div>

    <div id="updates">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-red-700">News and events</p>
      <h2 class="mt-3 text-3xl font-semibold text-stone-900 md:text-4xl">
        พื้นที่สำหรับข่าว ประกาศ และองค์ความรู้ล่าสุด
      </h2>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {
          updates.map((item) => (
            <a
              class="rounded-[1.5rem] border border-stone-200 bg-white p-6 transition hover:border-red-700"
              href={item.href}
            >
              <span class="rounded-full border border-red-700 bg-white px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-red-700">
                {item.type}
              </span>
              <h3 class="mt-4 text-xl font-semibold text-stone-900">{item.title}</h3>
              <p class="mt-3 text-sm leading-7 text-stone-600">{item.description}</p>
            </a>
          ))
        }
      </div>

      <div id="contact" class="mt-8 rounded-[2rem] border border-stone-200 bg-white p-8">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-red-700">Contact</p>
            <h3 class="mt-3 text-3xl font-semibold text-stone-900">พร้อมให้ทีมงานตอบกลับเรื่องหลักสูตรและบริการ</h3>
            <p class="mt-4 max-w-2xl text-base leading-7 text-stone-600">
              รอบนี้ปรับเฉพาะโครงสร้างและหน้าตาให้ใกล้เว็บไซต์เป้าหมายก่อน ส่วนข้อมูลจริง ปุ่มสมัคร
              และลิงก์ระบบหลังบ้านสามารถเสียบต่อในรอบถัดไปได้
            </p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row">
            <a class="btn-primary !rounded-md !px-7 !py-3.5" href="mailto:conc@tbs.tu.ac.th">ติดต่อทีมงาน</a>
            <a class="btn-secondary !rounded-md !border-stone-300 !px-7 !py-3.5 !text-stone-800" href="/contact#form"
              >ส่งแบบฟอร์ม</a
            >
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
