---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Executives',
  description: 'หน้ารายการผู้บริหารตัวอย่างสำหรับเว็บไซต์ CONC',
};

const executives = await getCollection('executive');
---

<Layout metadata={metadata}>
  <section class="border-b border-stone-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 md:px-6 md:py-20">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-red-700">About</p>
      <h1 class="mt-4 text-4xl font-semibold text-stone-900 md:text-5xl">Executives</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-stone-700">
        หน้ารายการนี้เริ่มแทนหน้า placeholder เดิมด้วยข้อมูลผู้บริหารตัวอย่าง และสามารถต่อยอดเป็น profile จริงได้ทันที
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 md:px-6">
    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {
        executives.map((item) => (
          <a
            class="rounded-[1.75rem] border border-stone-200 bg-white p-7 transition hover:border-red-700"
            href={getPermalink(`/executives/${item.id}`)}
          >
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-red-700">{item.data.role}</p>
            <h2 class="mt-3 text-2xl font-semibold text-stone-900">{item.data.name}</h2>
            <p class="mt-3 text-sm leading-7 text-stone-600">{item.data.expertise}</p>
            <ul class="mt-6 space-y-2 text-sm text-stone-700">
              {item.data.highlights.map((highlight) => (
                <li class="rounded-xl bg-neutral-100 px-4 py-3">{highlight}</li>
              ))}
            </ul>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
