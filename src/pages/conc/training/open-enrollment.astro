---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Open Enrollment Programs',
  description: 'หน้ารายการหลักสูตรตัวอย่างสำหรับบุคคลทั่วไป',
};

const programs = await getCollection('program');
---

<Layout metadata={metadata}>
  <section class="border-b border-stone-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 md:px-6 md:py-20">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-red-700">Training Service</p>
      <h1 class="mt-4 text-4xl font-semibold text-stone-900 md:text-5xl">Open Enrollment Programs</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-stone-700">
        หน้า listing นี้ใช้แสดงหลักสูตรที่เปิดรับสมัครจริง พร้อม category, format, วันที่
        และลิงก์ไปยังรายละเอียดรายหลักสูตรหรือหน้าสมัครเรียน
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 md:px-6">
    <div class="grid gap-6 lg:grid-cols-2">
      {
        programs.map((program) => {
          const detailHref = getPermalink(`/programs/${program.id}`);
          const applyHref = getPermalink(`/programs/${program.id}/apply`);

          return (
            <article class="rounded-[1.75rem] border border-stone-200 bg-white p-7 transition hover:border-red-700">
              <div class="flex flex-wrap items-center gap-3">
                <span class="rounded-full bg-red-700 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-white">
                  {program.data.badge}
                </span>
                <span class="text-sm text-stone-500">{program.data.category}</span>
                <span class="text-sm text-stone-500">{program.data.date}</span>
              </div>
              <h2 class="mt-5 text-2xl font-semibold leading-snug text-stone-900">{program.data.title}</h2>
              <p class="mt-4 text-sm leading-7 text-stone-600">{program.data.summary}</p>
              <div class="mt-6 flex flex-wrap gap-2 text-sm text-stone-700">
                <span class="rounded-full border border-stone-300 px-3 py-1">{program.data.format}</span>
                <span class="rounded-full border border-stone-300 px-3 py-1">{program.data.audience}</span>
              </div>
              <div class="mt-8 flex flex-wrap gap-3">
                <a class="btn-primary !rounded-md !px-6 !py-3" href={applyHref}>
                  สมัครหลักสูตร
                </a>
                <a class="btn-secondary !rounded-md !px-6 !py-3" href={detailHref}>
                  ดูรายละเอียด
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>
</Layout>
