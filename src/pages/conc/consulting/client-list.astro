---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const metadata = {
  title: 'Client List',
  description: 'หน้ากลุ่มลูกค้าและอุตสาหกรรมที่ CONC ให้บริการ',
};

const clientGroups = await getCollection('client-group');
---

<Layout metadata={metadata}>
  <section class="border-b border-stone-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 md:px-6 md:py-20">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-red-700">Consulting Service</p>
      <h1 class="mt-4 text-4xl font-semibold text-stone-900 md:text-5xl">Client List</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-stone-700">
        หน้านี้ใช้แทน social proof section ของบริการที่ปรึกษา โดยแสดงกลุ่มลูกค้าและอุตสาหกรรมที่ศูนย์ทำงานด้วยในภาพรวม
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 md:px-6">
    <div class="grid gap-6 md:grid-cols-3">
      {
        clientGroups.map((group) => (
          <article class="rounded-[1.75rem] border border-stone-200 bg-white p-7">
            <h2 class="text-2xl font-semibold text-stone-900">{group.data.sector}</h2>
            <ul class="mt-6 space-y-3 text-sm text-stone-700">
              {group.data.examples.map((example) => (
                <li class="rounded-xl bg-neutral-100 px-4 py-3">{example}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
