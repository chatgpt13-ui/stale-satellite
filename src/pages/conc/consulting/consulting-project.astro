---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const metadata = {
  title: 'Consulting Project',
  description: 'หน้าตัวอย่างโครงการที่ปรึกษาและ case-led consulting portfolio ของ CONC',
};

const consultingProjects = await getCollection('consulting-project');
---

<Layout metadata={metadata}>
  <section class="border-b border-stone-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 md:px-6 md:py-20">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-red-700">Consulting Service</p>
      <h1 class="mt-4 text-4xl font-semibold text-stone-900 md:text-5xl">Consulting Project</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-stone-700">
        หน้านี้ใช้สื่อสารตัวอย่างโครงการที่ปรึกษาในรูปแบบ case-led portfolio เพื่อให้ prospective clients
        เห็นกรอบการทำงานและผลลัพธ์ที่ศูนย์ส่งมอบได้
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 md:px-6">
    <div class="grid gap-6">
      {
        consultingProjects.map((project) => (
          <article class="rounded-[1.75rem] border border-stone-200 bg-white p-7">
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-red-700">{project.data.clientType}</p>
            <h2 class="mt-3 text-2xl font-semibold text-stone-900">{project.data.title}</h2>
            <div class="mt-6 grid gap-4 lg:grid-cols-3">
              <div class="rounded-xl bg-neutral-100 p-5">
                <h3 class="text-sm font-semibold uppercase tracking-[0.14em] text-stone-700">Challenge</h3>
                <p class="mt-3 text-sm leading-7 text-stone-600">{project.data.challenge}</p>
              </div>
              <div class="rounded-xl bg-neutral-100 p-5">
                <h3 class="text-sm font-semibold uppercase tracking-[0.14em] text-stone-700">Approach</h3>
                <p class="mt-3 text-sm leading-7 text-stone-600">{project.data.approach}</p>
              </div>
              <div class="rounded-xl bg-neutral-100 p-5">
                <h3 class="text-sm font-semibold uppercase tracking-[0.14em] text-stone-700">Outcome</h3>
                <p class="mt-3 text-sm leading-7 text-stone-600">{project.data.outcome}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
