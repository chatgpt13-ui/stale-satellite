---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'All News',
  description: 'หน้ารวมข่าว ประกาศ และกิจกรรมตัวอย่างของเว็บไซต์ CONC',
};

const updateItems = await getCollection('update');
---

<Layout metadata={metadata}>
  <section class="border-b border-stone-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 md:px-6 md:py-20">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-red-700">News & Events</p>
      <h1 class="mt-4 text-4xl font-semibold text-stone-900 md:text-5xl">All News</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-stone-700">
        หน้า archive นี้เริ่มทำงานเป็น news hub ได้จริงแล้ว โดยรวมทั้งข่าว ประกาศ และกิจกรรม พร้อมลิงก์ไปหน้า detail
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 md:px-6">
    <div class="grid gap-6 lg:grid-cols-3">
      {
        updateItems.map((item) => (
          <a
            class="rounded-[1.5rem] border border-stone-200 bg-white p-6 transition hover:border-red-700"
            href={getPermalink(`/updates/${item.id}`)}
          >
            <span class="rounded-full border border-red-700 bg-white px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-red-700">
              {item.data.type}
            </span>
            <p class="mt-4 text-sm text-stone-500">{item.data.date}</p>
            <h2 class="mt-3 text-2xl font-semibold text-stone-900">{item.data.title}</h2>
            <p class="mt-4 text-sm leading-7 text-stone-600">{item.data.summary}</p>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
