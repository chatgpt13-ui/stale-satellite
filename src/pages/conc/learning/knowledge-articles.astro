---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const metadata = {
  title: 'Knowledge Articles',
  description: 'หน้ารวมบทความความรู้ของ CONC',
};

const knowledgeArticles = await getCollection('knowledge-article');
---

<Layout metadata={metadata}>
  <section class="border-b border-stone-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 md:px-6 md:py-20">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-red-700">Learning</p>
      <h1 class="mt-4 text-4xl font-semibold text-stone-900 md:text-5xl">Knowledge Articles</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-stone-700">
        หน้านี้ทำหน้าที่เป็น editorial hub สำหรับบทความและ insight ที่ช่วยสร้าง thought leadership
        และเชื่อมโยงผู้อ่านไปยังโปรแกรมที่เกี่ยวข้อง
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 md:px-6">
    <div class="grid gap-6 lg:grid-cols-3">
      {
        knowledgeArticles.map((item) => (
          <article class="rounded-[1.5rem] border border-stone-200 bg-white p-6">
            <span class="rounded-full border border-red-700 bg-white px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-red-700">
              {item.data.category}
            </span>
            <h2 class="mt-4 text-2xl font-semibold text-stone-900">{item.data.title}</h2>
            <p class="mt-4 text-sm leading-7 text-stone-600">{item.data.summary}</p>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
