---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Contact"
    title="Contact CONC"
    subtitle="ส่งคำถามเกี่ยวกับหลักสูตร งานให้คำปรึกษา หรือความร่วมมือผ่านแบบฟอร์มด้านล่าง"
  />

  <ContactUs
    id="form"
    title="Contact CONC"
    subtitle="สำหรับคำถามทั่วไป การสมัครหลักสูตร การขอ customized training หรือการขอให้ทีมงานติดต่อกลับ"
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
        placeholder: 'ชื่อผู้ติดต่อ',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
        placeholder: 'name@example.com',
      },
      {
        type: 'text',
        name: 'organization',
        label: 'Organization',
        placeholder: 'ชื่อองค์กรหรือหน่วยงาน',
      },
    ]}
    textarea={{
      label: 'Message',
      name: 'message',
      placeholder: 'อธิบายความต้องการ โจทย์งาน หรือหลักสูตรที่สนใจ',
      rows: 6,
    }}
    disclaimer={{
      label: 'ยินยอมให้ทีมงานจัดเก็บข้อมูลที่จำเป็นเพื่อใช้ในการติดต่อกลับ',
    }}
    button="Send message"
    description="ฟอร์มนี้รองรับ Netlify Forms และจะพาไปยังหน้าขอบคุณหลังส่งสำเร็จ"
    formOptions={{
      name: 'general-contact',
      method: 'post',
      action: '/contact-success',
      netlify: true,
      honeypot: 'company-website',
    }}
  />

  <Features2
    title="ช่องทางการติดต่อ"
    items={[
      {
        title: 'General inquiries',
        description:
          'สอบถามข้อมูลหลักสูตร ปฏิทินอบรม ข่าวสาร และเอกสารประกอบการเรียนรู้ผ่านแบบฟอร์มติดต่อหรืออีเมลกลางของศูนย์',
      },
      {
        title: 'Training and consulting requests',
        description:
          'สำหรับองค์กรที่ต้องการ customized training, workshop, executive development หรือโครงการให้คำปรึกษา สามารถส่ง brief เบื้องต้นมาให้ทีมงานประเมินได้',
      },
      {
        title: 'Follow-up and coordination',
        description:
          'เมื่อได้รับข้อมูลแล้ว ทีมงานจะติดต่อกลับตามรายละเอียดที่ให้ไว้เพื่อยืนยันความต้องการและขั้นตอนถัดไป',
      },
      {
        title: 'Email',
        description: 'conc@tbs.tu.ac.th',
        icon: 'tabler:mail',
      },
      {
        title: 'Contact form',
        description: 'ใช้แบบฟอร์มบนหน้านี้เพื่อส่งคำถามหรือคำขอให้ทีมงานติดต่อกลับ',
        icon: 'tabler:forms',
      },
      {
        title: 'Location',
        description: 'Thammasat Business School, Thammasat University',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
